-- cmark-gfm fork: makes core-extension registration thread-safe, so parsing
-- Markdown from more than one thread does not abort the process.
--
-- Upstream's `ensurePluginsRegistered` calls straight through to a C function
-- that guards itself with a plain non-atomic check-then-set, so two threads can
-- both register the core extensions; the second registration calls
-- `cmark_register_node_flag` on an already-initialised global, which prints
-- "flag initialization error in cmark_register_node_flag" and abort()s. The
-- symptom is SIGABRT -- not a catchable exception, and not a failure a test
-- suite can report. Full mechanism: mori://kivikakk/cmark-gfm-hs,
-- upstream-issues entry
-- `cmark-gfm-hs-unsafe-concurrent-extension-registration`.
--
-- **okf is not exposed to this today.** Nothing in okf-core or okf-cli forks a
-- thread; the `okf` executable builds with -N but parses sequentially, and
-- neither test suite is threaded. This pin is here for two other reasons.
--
-- First, it is okf-core's *API* that carries the hazard to others. Every bundle
-- read parses Markdown, so any consumer that walks or validates bundles
-- concurrently inherits the abort -- which is how it was found, in
-- mori://shinzui/shikumi, whose shikumi-okf suite runs tasty with -N and died
-- at exit code 134 with an empty log.
--
-- Second, the exposure here is one `-with-rtsopts=-N` away. The day a test
-- suite or a command in this repo gains concurrency, the failure returns, and
-- it presents as anything but a dependency defect.
--
-- Note this pin governs builds *of this repository only*. It does not reach
-- anyone depending on okf-core from Hackage; they resolve stock cmark-gfm and
-- keep the abort. The durable fix is upstream, not here.
--
-- Pinned by commit, never by branch. Remove this stanza to fall back to Hackage
-- cmark-gfm 0.2.6 exactly -- which is the newest release, so there is no fixed
-- version to move to instead.
source-repository-package
  type: git
  location: https://github.com/shinzui/cmark-gfm-hs.git
  tag: a9014e8c4974d636e7c8f85cd97812905d217faf

-- GHC is provided by the Nix devShell from `nix-haskell-flake` (currently
-- pinned to ghc9124). Add a `with-compiler:` line here if you want
-- cabal to fail loudly when the version drifts from the flake.

test-show-details: direct
tests: True

-- Parallel module compilation
jobs: $ncpus
