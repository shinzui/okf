# flake.module.nix — project-specific flake-parts customizations.
#
# seihou does NOT manage this file: it is never regenerated or overwritten by
# `seihou run` or module migrations, so it is the conflict-free home for every
# customization that must survive nix-haskell-flake template upgrades. See
# flake.module.nix.example (generated by the module) for the full option list.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ REQUIRED: this file MUST be git-tracked (`git add flake.module.nix`).      │
# │ Nix flakes evaluate only files tracked by git, so flake.nix's              │
# │ `builtins.pathExists ./flake.module.nix` import guard sees an untracked    │
# │ file as ABSENT and silently ignores everything below.                      │
# └──────────────────────────────────────────────────────────────────────────┘
{ inputs, ... }:
{
  perSystem = { pkgs, config, ... }:
    let
      # The shared channel owns toolchain and compatibility patches. Its
      # immutable first-party catalog no longer consumes baikai-src overrides,
      # so select this project's released family explicitly after that channel.
      # Source: mori://shinzui/baikai; release pin: flake.nix.
      haskellPackages = pkgs.haskell.packages.ghc9124.override {
        overrides = pkgs.lib.composeExtensions
          (inputs.haskell-nix.lib.haskellExtension pkgs.haskell.lib.compose pkgs)
          (final: prev:
            pkgs.lib.genAttrs
              [ "baikai" "baikai-claude" "baikai-kit" "baikai-openai" ]
              (name: pkgs.haskell.lib.compose.doJailbreak (pkgs.haskell.lib.compose.overrideCabal
                # Preserve the channel's relaxed bounds and upstream-test policy;
                # the release's
                # process tests need /bin/ps outside Darwin's build sandbox.
                (drv: {
                  doCheck = prev.${name}.doCheck;
                  # Monorepo packages link LICENSE to their parent; Cabal's
                  # subdirectory source would otherwise leave a dangling link.
                  prePatch = (drv.prePatch or "") + ''
                    cp --remove-destination ${inputs.haskell-nix.inputs.baikai-src}/LICENSE LICENSE
                  '';
                })
                (final.callCabal2nix name
                  (inputs.haskell-nix.inputs.baikai-src + "/${name}")
                  { }))));
      };

      # okf is a multi-package project: okf-core (library) and okf-cli (library +
      # `okf` executable, depends on okf-core). There is no root .cabal file, so
      # callCabal2nix is pointed at each package directory and okf-cli is given
      # okf-core as its inter-package dependency. nix.builtin-package = false, so
      # the seihou-managed nix/haskell.nix emits no packages.default to collide
      # with these definitions.

      # 7-char git SHA of this flake's source. Absent on a dirty tree, where we
      # fall back to "dirty"; the okf binary's --version then prints
      # "okf v0.9.0.0 (dirty)".
      gitRev = inputs.self.shortRev or "dirty";

      okf-core =
        haskellPackages.callCabal2nix "okf-core" (inputs.self + "/okf-core") { };

      # nix build strips .git/, so the Template Haskell hash read in
      # Okf.Cli.Version returns Left. We inject the SHA as the CPP macro GIT_HASH
      # at configure time so the module's #ifdef GIT_HASH fallback supplies it.
      # The escaped quotes make GIT_HASH expand to a Haskell string literal.
      okf-cli = pkgs.haskell.lib.compose.overrideCabal
        (drv: {
          configureFlags = (drv.configureFlags or [ ]) ++ [
            "--ghc-option=-DGIT_HASH=\"${builtins.substring 0 7 gitRev}\""
          ];
        })
        (haskellPackages.callCabal2nix "okf-cli" (inputs.self + "/okf-cli") {
          inherit okf-core;
        });
    in
    {
      # fzf powers the interactive bundle and concept pickers in `okf show`
      # (see docs/adr/2-interactive-bundle-and-concept-selection.md). It is an
      # optional *runtime* dependency — okf builds, tests, and runs without it —
      # but shipping it in the dev shell means the pickers can be exercised
      # straight from a fresh clone.
      haskellProject.extraDevPackages = [ pkgs.fzf ];

      packages.okf-core = okf-core;
      packages.okf-cli = okf-cli;
      packages.default = okf-cli;
    };
}
